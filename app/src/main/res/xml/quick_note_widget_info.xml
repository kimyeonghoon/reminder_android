<?xml version="1.0" encoding="utf-8"?>
<!-- Widget configuration for quick note widget
     - targetCellWidth/targetCellHeight: API 31+ attributes for better sizing (ignored on older versions)
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="120dp"
    android:minHeight="120dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_quick_note"
    android:description="@string/quick_note_widget_description"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:previewImage="@android:drawable/ic_input_add" />
